# Données : jamais versionnées, elles se régénèrent depuis l'API.
# Sans barre oblique finale, le motif couvre aussi le cas où `data` est un lien
# symbolique vers un autre disque — un lien versionné pointerait vers un chemin
# propre à une machine et serait mort après clonage.
data
*.parquet
logs_backfill.log

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# Scala / sbt
spark-jobs/target/
spark-jobs/project/target/
spark-jobs/project/project/
.bsp/

# dbt
dbt/dpe_analytics/target/
dbt/dpe_analytics/dbt_packages/
dbt/dpe_analytics/logs/

# Power BI : le .pbix contient les données importées, trop lourd pour Git.
# Seul le modèle exporté en .bim et les captures sont versionnés.
*.pbix

# Divers
.DS_Store
.idea/

# Runtime Spark telecharge localement
tools/

# Sorties et fichiers de travail de Playwright MCP
.playwright-mcp/
