# Copier en .env et adapter. Le fichier .env n'est pas versionné.

# --- MinIO (lac de données) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changez-moi

# --- Entrepôt PostgreSQL ---
WAREHOUSE_USER=dpe
WAREHOUSE_PASSWORD=changez-moi

# --- Spark ---
# À ajuster selon la RAM disponible : compter ~4 Go pour traiter 15 M de lignes.
SPARK_DRIVER_MEMORY=4g

# --- Ingestion ---
DPE_BRONZE_ROOT=s3://lakehouse/bronze
DPE_PAGE_SIZE=10000
DPE_SLEEP_BETWEEN_PAGES=0.2

# GID du groupe docker de l hote, requis pour qu Airflow puisse soumettre
# les jobs au conteneur Spark. Obtenir avec : stat -c %%g /var/run/docker.sock
DOCKER_GID=999

# uid de l utilisateur courant, pour que Airflow puisse ecrire dans les
# repertoires montes depuis l hote. Obtenir avec : id -u
AIRFLOW_UID=1000

# uid de l utilisateur courant, partage par les conteneurs Spark et Airflow
# pour ecrire dans les repertoires montes. Obtenir avec : id -u
HOST_UID=1000
