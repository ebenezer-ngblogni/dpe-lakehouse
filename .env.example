# Copier en .env et adapter. Le fichier .env n'est pas versionné.

# --- MinIO (lac de données) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changez-moi

# --- Entrepôt PostgreSQL ---
WAREHOUSE_USER=dpe
WAREHOUSE_PASSWORD=changez-moi

# --- Spark ---
# À ajuster selon la RAM disponible : compter ~4 Go pour traiter 15 M de lignes.
SPARK_DRIVER_MEMORY=4g

# --- Ingestion ---
DPE_BRONZE_ROOT=s3://lakehouse/bronze
DPE_PAGE_SIZE=10000
DPE_SLEEP_BETWEEN_PAGES=0.2
